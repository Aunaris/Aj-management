# คัดลอกเป็น .env แล้วแก้ค่า (ไฟล์ .env ไม่ถูกเก็บใน git)

# โดเมนที่ฝ่ายไอทีออกให้ (ต้องชี้ DNS มาที่ IP ของเซิร์ฟเวอร์นี้แล้ว)
DOMAIN=anim.example.ac.th

# จำนวน reverse proxy หน้าระบบ: 1 = Caddy อย่างเดียว
# ถ้ามหาวิทยาลัยมี proxy/load balancer อีกชั้นก่อนถึงเครื่องนี้ ให้ตั้งเป็น 2
TRUST_PROXY=1

# วันเปิดภาคเรียน (วันจันทร์ของสัปดาห์ที่ 1) รูปแบบ ค.ศ. ปปปป-ดด-วว
TERM_START_DATE=2026-11-16

# ขนาดไฟล์งานสูงสุดต่อไฟล์ (MB) — ระบบอ่านไฟล์ทั้งไฟล์ในหน่วยความจำ อย่าตั้งเกินครึ่งหนึ่งของ RAM
MAX_UPLOAD_MB=200

# รหัสผ่านเริ่มต้นของบัญชีนักศึกษา (บังคับเปลี่ยนเมื่อเข้าสู่ระบบครั้งแรก)
STUDENT_DEFAULT_PASSWORD=123456
