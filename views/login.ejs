<div class="login-card">
  <div class="brand-mark">2D</div>
  <h1>2D Animation Classroom</h1>
  <p class="muted"><%= course ? course.course_code + ' ' + course.course_name : '' %><br><%= course ? 'ภาคการศึกษา ' + course.semester + '/' + course.academic_year : '' %></p>
  <% if (error) { %><div class="flash error" role="alert"><%= error %></div><% } %>
  <form method="post" action="/login" class="stack" autocomplete="on">
    <input type="hidden" name="next" value="<%= next %>">
    <label><span class="l">รหัสนักศึกษา / ชื่อผู้ใช้</span><input type="text" name="login" value="<%= login %>" required autofocus autocomplete="username"></label>
    <label><span class="l">รหัสผ่าน</span><input type="password" name="password" required autocomplete="current-password"></label>
    <button class="btn lg" type="submit" style="width:100%">เข้าสู่ระบบ</button>
  </form>
  <% if (next && next.startsWith('/checkin')) { %><p class="hint">เข้าสู่ระบบเพื่อเช็คชื่อ หาก QR หมดอายุระหว่างเข้าสู่ระบบ ให้สแกน QR ล่าสุดบนจออีกครั้ง หรือพิมพ์รหัส 6 ตัวที่แสดงใต้ QR</p><% } %>
  <p class="hint">นักศึกษา: ใช้รหัสนักศึกษาเป็นชื่อผู้ใช้ รหัสผ่านเริ่มต้นคือรหัสนักศึกษา (ระบบจะให้เปลี่ยนเมื่อเข้าสู่ระบบครั้งแรก)</p>
</div>
