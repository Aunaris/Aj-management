<div class="card" style="max-width:480px">
  <h1>เปลี่ยนรหัสผ่าน</h1>
  <% if (user.must_change_password) { %><p class="flash warning">กรุณาตั้งรหัสผ่านใหม่ก่อนเริ่มใช้งาน</p><% } %>
  <form method="post" action="/account/password" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label><span class="l">รหัสผ่านปัจจุบัน</span><input type="password" name="current" required autocomplete="current-password"></label>
    <label><span class="l">รหัสผ่านใหม่ (อย่างน้อย 8 ตัวอักษร)</span><input type="password" name="password" required minlength="8" autocomplete="new-password"></label>
    <label><span class="l">ยืนยันรหัสผ่านใหม่</span><input type="password" name="confirm" required minlength="8" autocomplete="new-password"></label>
    <button class="btn" type="submit">บันทึก</button>
  </form>
</div>
