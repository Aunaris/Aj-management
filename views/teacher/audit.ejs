<div class="page-head"><div><h1>Audit Log</h1><p>ประวัติการแก้ไขคะแนน การเช็คชื่อ การเผยแพร่ผล และการตั้งค่า (500 รายการล่าสุด)</p></div>
  <form method="get" class="row" style="max-width:360px"><select name="type"><option value="">ทุกประเภท</option><% ['grading_record','attendance_record','assignment','course_session','attendance_risk_event','attendance_appeal','course','user','report','submission'].forEach(t => { %><option value="<%= t %>" <%= type === t ? 'selected' : '' %>><%= t %></option><% }) %></select><button class="btn sm ghost">กรอง</button></form>
</div>
<div class="table-wrap"><table>
  <tr><th>เวลา</th><th>ผู้ดำเนินการ</th><th>การกระทำ</th><th>ประเภท</th><th>รายละเอียด (ค่าเดิม → ค่าใหม่)</th></tr>
  <% logs.forEach(l => { %><tr><td><small><%= u.thaiDate(l.created_at, { time: true }) %></small></td><td><%= l.actor_name || '—' %></td><td><code><%= l.action %></code></td><td><small><%= l.entity_type %></small></td>
    <td><small style="word-break:break-all"><%= l.metadata ? JSON.stringify(l.metadata) : '' %></small></td></tr><% }) %>
</table></div>
