<div class="page-head"><div><h1>ตั้งค่ารายวิชา</h1><p><%= c.course_code %> <%= c.course_name %> · <%= c.faculty %></p></div></div>
<div class="card">
  <h2>ข้อมูลรายวิชา</h2>
  <form method="post" action="/teacher/settings/course" class="row" style="align-items:end">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label style="flex:0 0 140px"><span class="l">รหัสวิชา</span><input type="text" name="course_code" value="<%= c.course_code %>" required></label>
    <label style="flex:3"><span class="l">ชื่อวิชา</span><input type="text" name="course_name" value="<%= c.course_name %>"></label>
    <label style="flex:0 0 100px"><span class="l">ภาคเรียน</span><input type="text" name="semester" value="<%= c.semester %>" required></label>
    <label style="flex:0 0 120px"><span class="l">ปีการศึกษา</span><input type="text" name="academic_year" value="<%= c.academic_year %>" required></label>
    <div style="flex:0 0 auto"><button class="btn sm">บันทึก</button></div>
  </form>
  <p class="hint">ไฟล์รายชื่อจากระบบทะเบียนระบุ 10801327 ภาคเรียน 2/2569 ส่วน OBE-3/Blueprint ระบุ 10802103 ภาคเรียน 1/2569 — ตรวจสอบให้ตรงกับรายวิชาจริง · <a href="/teacher/sections">จัดการกลุ่มเรียน</a></p>
</div>
<div class="grid g2">
  <div class="card">
    <h2>โครงสร้างคะแนนตาม OBE-3 <%- c.structure_confirmed_at ? '<span class="badge ok">ยืนยันแล้ว</span>' : '<span class="badge warn">รอยืนยัน</span>' %></h2>
    <p class="hint">ค่าเริ่มต้นถอดจาก OBE-3 หมวด 8 (รวม 100 คะแนน) ระบบไม่เพิ่ม/ลด/เปลี่ยนการจัดสรรคะแนนอัตโนมัติ และไม่สร้างหมวดสอบกลางภาค/ปลายภาคจนกว่าผู้สอนยืนยัน</p>
    <form method="post" action="/teacher/settings/categories">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <table><tr><th>หมวด</th><th>CLO</th><th class="num">คะแนน</th></tr>
        <% categories.forEach(cat => { %><tr><td><%= cat.category_name %><br><small class="muted"><%= cat.rubric_hint %></small></td><td><%= cat.clo_reference %></td>
          <td class="num"><% if (user.role === 'admin' && !c.structure_confirmed_at) { %><input class="score" type="number" step="0.5" min="0" name="max_<%= cat.id %>" value="<%= cat.max_score %>"><% } else { %><%= cat.max_score %><% } %></td></tr><% }) %>
        <tr><th>รวม</th><th></th><th class="num"><%= structure.total %></th></tr>
      </table>
      <% if (user.role === 'admin' && !c.structure_confirmed_at) { %><button class="btn sm ghost" type="submit" style="margin-top:.5rem">บันทึกคะแนนหมวด (Admin)</button><% } %>
    </form>
    <% if (!c.structure_confirmed_at && user.role === 'teacher') { %>
      <form method="post" action="/teacher/settings/confirm-structure" style="margin-top:.8rem" data-confirm="ยืนยันว่าโครงสร้างคะแนนถูกต้องตาม OBE-3 และพร้อมเปิดใช้งาน?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn">ตรวจสอบแล้ว ยืนยันโครงสร้างคะแนน</button></form>
    <% } else if (c.structure_confirmed_at) { %><p class="hint">ยืนยันเมื่อ <%= u.thaiDate(c.structure_confirmed_at, { time: true }) %></p><% } %>
  </div>
  <div class="card">
    <h2>การเช็คชื่อและการแจ้งเตือน</h2>
    <form method="post" action="/teacher/settings" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="row">
        <label><span class="l">อายุ QR (วินาที)</span><input type="number" name="qr_ttl_seconds" min="15" max="600" value="<%= c.qr_ttl_seconds %>"><div class="hint">แนะนำ 30–60 วินาที</div></label>
        <label><span class="l">มาสายเมื่อเกิน (นาที)</span><input type="number" name="late_after_minutes" min="0" max="240" value="<%= c.late_after_minutes %>"><div class="hint">นับจากเวลาเริ่มคาบ (หรือเวลาเปิดเช็คชื่อ)</div></label>
      </div>
      <fieldset id="attendance"><legend>ป้องกันการเช็คชื่อแทน</legend>
        <label class="check"><input type="checkbox" name="device_lock" value="1" <%= c.device_lock ? 'checked' : '' %>><span><strong>1 เครื่อง เช็คชื่อได้ 1 คนต่อคาบ</strong> — ปฏิเสธบัญชีที่สองที่ใช้เครื่องเดียวกัน (ตรวจจาก Device ID ในเบราว์เซอร์) และสร้าง Risk Event</span></label>
        <label><span class="l">จำกัดเครือข่ายที่เช็คชื่อได้ (IP/CIDR คั่นด้วย , เว้นว่าง = ไม่จำกัด)</span><input type="text" name="ip_allowlist" value="<%= c.ip_allowlist || '' %>" placeholder="เช่น 202.28.10.0/24, 10.0.0.0/8">
          <div class="hint">IP สาธารณะที่ผู้สอนใช้อยู่ตอนนี้: <code><%= clientIp %></code> — นักศึกษาที่ใช้ Wi-Fi เดียวกันจะมี IP เดียวกัน จึงใช้ IP จำกัด "เครือข่าย" ได้ แต่ใช้แยก "เครื่อง" ไม่ได้</div></label>
        <label class="check"><input type="checkbox" name="geo_enabled" value="1" <%= c.geo_enabled ? 'checked' : '' %>><span><strong>ตรวจตำแหน่ง GPS</strong> — นักศึกษาต้องอนุญาต Location และอยู่ในรัศมีห้องเรียน (ต้องเปิดระบบผ่าน HTTPS)</span></label>
        <div class="row">
          <label><span class="l">ละติจูดห้องเรียน</span><input type="text" name="geo_lat" value="<%= c.geo_lat ?? '' %>" inputmode="decimal"></label>
          <label><span class="l">ลองจิจูด</span><input type="text" name="geo_lng" value="<%= c.geo_lng ?? '' %>" inputmode="decimal"></label>
        </div>
        <button class="btn sm ghost" type="button" data-set-geo="fields">📍 ใช้ตำแหน่งปัจจุบันของเครื่องนี้</button> <span class="hint" data-geo-status></span>
        <div class="row" style="margin-top:.5rem">
          <label><span class="l">รัศมีที่อนุญาต (เมตร)</span><input type="number" name="geo_radius_m" min="10" max="5000" value="<%= c.geo_radius_m %>"></label>
          <label><span class="l">ความคลาดเคลื่อน GPS สูงสุด (เมตร)</span><input type="number" name="geo_max_accuracy_m" min="10" max="5000" value="<%= c.geo_max_accuracy_m %>"></label>
        </div>
        <p class="hint">GPS ในอาคารมักคลาดเคลื่อน 20–100 ม. แนะนำรัศมี 100–200 ม. · ตั้งจุดเฉพาะคาบได้จากหน้า "ระหว่างคาบ" · พิกัด GPS ของนักศึกษาจะถูกลบหลัง 30 วัน (เก็บไว้เฉพาะระยะห่าง)</p>
      </fieldset>
      <label class="check"><input type="checkbox" name="device_binding" value="1" <%= c.device_binding ? 'checked' : '' %>><span>เปิด Device Binding — ผูกอุปกรณ์หลักกับบัญชี และแจ้งเตือนเมื่อเปลี่ยนอุปกรณ์ (ไม่ใช่หลักฐานยืนยันตัวบุคคล)</span></label>
      <label class="check"><input type="checkbox" name="clo_visible_to_students" value="1" <%= c.clo_visible_to_students ? 'checked' : '' %>><span>เปิดให้นักศึกษาเห็นความก้าวหน้า CLO ของตนเอง</span></label>
      <label><span class="l">เตือนก่อนกำหนดส่ง (ชั่วโมง คั่นด้วย ,)</span><input type="text" name="reminder_hours" value="<%= c.reminder_hours %>"></label>
      <label><span class="l">ช่องทางติดต่อผู้สอน</span><input type="text" name="contact" value="<%= c.contact || '' %>"></label>
      <p class="hint">Privacy: ระบบไม่เก็บภาพใบหน้าหรือข้อมูลชีวมิติ · เก็บ GPS เฉพาะเมื่อเปิดใช้ · เก็บ Device ID เป็นค่า hash · ล้างประวัติคำขอเช็คชื่อหลัง 30 วัน และ Risk Event ที่ตรวจแล้วหลัง <%= c.risk_retention_days %> วัน</p>
      <button class="btn sm" type="submit">บันทึก</button>
    </form>
  </div>
</div>
<div class="card" id="documents">
  <h2>เอกสารรายวิชา (OBE-3, แผนการสอน, เกณฑ์ประเมิน)</h2>
  <ul class="list"><% documents.forEach(d => { %><li><div><%= d.title %><br><small><%= d.file_name || d.external_url || '' %></small></div>
    <div class="actions"><% if (d.file_storage_key) { %><a class="btn sm ghost" href="/files/document/<%= d.id %>" target="_blank" rel="noopener">เปิด</a><% } %>
    <% if (user.role === 'teacher') { %><form method="post" action="/teacher/documents/<%= d.id %>/delete" data-confirm="ลบเอกสารนี้?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm ghost">ลบ</button></form><% } %></div></li><% }) %></ul>
  <% if (user.role === 'teacher') { %>
  <form method="post" action="/teacher/documents" enctype="multipart/form-data" class="stack" style="margin-top:.8rem">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="row"><label><span class="l">ชื่อเอกสาร</span><input type="text" name="title" required></label><label><span class="l">ไฟล์ (PDF ฯลฯ)</span><input type="file" name="file"></label><label><span class="l">หรือ URL</span><input type="url" name="external_url"></label></div>
    <button class="btn sm" type="submit">เพิ่มเอกสาร</button>
  </form>
  <% } %>
</div>
<div class="card">
  <h2>CLOs</h2>
  <table><tr><th>CLO</th><th>คำอธิบาย</th><th>PLO</th><th>เกณฑ์ผ่าน</th></tr>
    <% clos.forEach(x => { %><tr><td><%= x.clo_code %></td><td><%= x.description %></td><td><small><%= x.plo_mapping %></small></td><td><%= x.passing_criteria ?? 'ยังไม่กำหนด' %> <a href="/teacher/clo" class="hint">ตั้งค่า</a></td></tr><% }) %>
  </table>
</div>
