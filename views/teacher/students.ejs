<div class="page-head">
  <div><h1>รายชื่อนักศึกษา</h1><p><%= students.filter(s => s.enrollment_status === 'active').length %> คนที่ลงทะเบียน</p></div>
  <a class="btn ghost" href="/teacher/reports/progress.csv">ส่งออกความก้าวหน้า</a>
</div>
<div class="grid g-side">
  <div class="card">
    <div class="table-wrap"><table>
      <tr><th>รหัส</th><th>ชื่อ-นามสกุล</th><th>กลุ่ม</th><th class="num">เข้าเรียน</th><th>สถานะ</th></tr>
      <% students.forEach(s => { const r = rate[s.id]; %>
        <tr><td><small><%= s.student_code %></small></td><td><a href="/teacher/students/<%= s.id %>"><%= s.full_name %></a><% if (s.email) { %><br><small><%= s.email %></small><% } %></td><td><%= s.section || '' %></td>
          <td class="num"><%= r && r.rate !== null ? r.rate + '%' : '—' %><% if (r) { %><br><small>ขาด <%= r.absent %> · สาย <%= r.late %></small><% } %></td>
          <td><%- s.enrollment_status === 'active' ? '<span class="badge ok">ลงทะเบียน</span>' : '<span class="badge muted">ถอน</span>' %></td></tr>
      <% }) %>
    </table></div>
    <% if (!students.length) { %><div class="empty">ยังไม่มีนักศึกษา นำเข้ารายชื่อจากแบบฟอร์มด้านขวา</div><% } %>
  </div>
  <div>
    <div class="card">
      <h2>นำเข้ารายชื่อ (Excel/CSV)</h2>
      <p class="hint">คัดลอกจาก Excel แล้ววาง หรืออัปโหลด CSV (UTF-8) คอลัมน์: <code>รหัสนักศึกษา, ชื่อ-นามสกุล, อีเมล, กลุ่มเรียน</code> (2 คอลัมน์แรกบังคับ) — รหัสผ่านเริ่มต้น = รหัสนักศึกษา และต้องเปลี่ยนเมื่อเข้าสู่ระบบครั้งแรก</p>
      <form method="post" action="/teacher/students/import" class="stack">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <textarea name="data" rows="8" placeholder="6501101001	กมลชนก ใจดี	kamol@example.com	S1"></textarea>
        <button class="btn sm" type="submit">นำเข้า</button>
      </form>
      <form method="post" action="/teacher/students/import-file" enctype="multipart/form-data" class="stack" style="margin-top:.8rem">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="file" name="file" accept=".csv,.txt" required>
        <button class="btn sm ghost" type="submit">อัปโหลด CSV</button>
      </form>
    </div>
  </div>
</div>
