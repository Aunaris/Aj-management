<div class="card" style="max-width:520px;margin:0 auto;text-align:center">
  <% if (ok) { %>
    <div style="font-size:3rem">✅</div>
    <h1>เช็คชื่อสำเร็จ</h1>
    <p>สัปดาห์ <%= s.week_number %>: <%= s.title %></p>
    <p><%- u.badge('attendance', result.status) %> เวลา <%= u.thaiDate(result.record.checkin_time, { time: true }) %></p>
    <% result.warnings.forEach(w => { %><div class="flash warning"><%= w %></div><% }) %>
    <a class="btn" href="/sessions/<%= s.id %>">ดูรายละเอียดคาบ / ยืนยันรหัสในห้อง</a>
  <% } else { %>
    <div style="font-size:3rem"><%= error.code === 'duplicate' ? 'ℹ️' : '⚠️' %></div>
    <h1><%= error.code === 'duplicate' ? 'เช็คชื่อแล้ว' : 'เช็คชื่อไม่สำเร็จ' %></h1>
    <p><%= error.message %></p>
    <% if (result && result.record) { %><p><%- u.badge('attendance', result.record.attendance_status) %> <%= u.thaiDate(result.record.checkin_time, { time: true }) %></p><% } %>
    <div class="actions" style="justify-content:center"><a class="btn" href="/checkin">ลองอีกครั้ง (กรอกรหัส)</a><% if (s) { %><a class="btn ghost" href="/sessions/<%= s.id %>">รายละเอียดคาบ</a><% } %></div>
  <% } %>
</div>
